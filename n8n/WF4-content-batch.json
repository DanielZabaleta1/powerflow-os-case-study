          }
        ]
      ]
    },
    "Build Gemini Body": {
      "main": [
        [
          {
            "node": "Gemini 3 Drafts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini 3 Drafts": {
      "main": [
        [
          {
            "node": "Parse 3 Drafts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse 3 Drafts": {
      "main": [
        [
          {
            "node": "Save Drafts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Drafts": {
      "main": [
